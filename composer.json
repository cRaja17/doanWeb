{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "anayarojo/shoppingcart": "^4.2",
        "awcodes/filament-curator": "^5.1",
        "ckfinder/ckfinder-laravel-package": "*",
        "cviebrock/eloquent-sluggable": "*",
        "filament/filament": "^5.7",
        "guzzlehttp/guzzle": "*",
        "lara-zeus/spatie-translatable": "^2.0",
        "laravel/ai": "*",
        "laravel/framework": "^13.0",
        "laravel/reverb": "^1.11",
        "laravel/sanctum": "*",
        "laravel/tinker": "*",
        "mcamara/laravel-localization": "*",
        "nyholm/psr7": "*",
        "railsware/mailtrap-php": "*",
        "spatie/laravel-html": "*",
        "spatie/laravel-sitemap": "*",
        "spatie/laravel-translatable": "*",
        "spatie/laravel-translation-loader": "*",
        "spatie/laravel-webhook-server": "*",
        "srmklive/paypal": "*",
        "stichoza/google-translate-php": "*",
        "symfony/http-client": "*",
        "tymon/jwt-auth": "*"
    },
    "require-dev": {
        "fakerphp/faker": "*",
        "phpunit/phpunit": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "patched/*",
            "options": {
                "symlink": false,
                "versions": {
                    "anayarojo/shoppingcart": "4.2.4",
                    "ckfinder/ckfinder-laravel-package": "v5.0.2"
                }
            }
        }
    ],
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "codezero/composer-preload-files": true
        },
        "audit": {
            "abandoned": "ignore",
            "block-insecure": false
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
